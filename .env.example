# Web interface and initial administrator account.
# Change this password before starting the container.
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this-password-now

# Host directory for persistent account, Discord and other dashboard settings.
# Relative paths are resolved next to compose.yml; absolute paths are also valid.
DASHBOARD_CONFIG_PATH=./config

# Set to false to display containers without allowing start/stop/restart actions.
ALLOW_DOCKER_ACTIONS=true

# Optional extra Data Browser roots when automatic SMB/NFS/mount detection
# does not include them. Separate multiple absolute paths with commas.
# Example: /data/media,/data/backups
SHARE_ROOTS=

# SSH target for the full host terminal. "auto" uses the dashboard host name/IP.
SSH_HOST=auto
SSH_PORT=22

# "auto" monitors the interface(s) used by the host's default route.
# Set a specific interface or comma-separated list if required.
# Examples: bond0 or eno1,eno2
NETWORK_INTERFACE=auto

# Set to true only when the dashboard is served through HTTPS.
COOKIE_SECURE=false

# Login session lifetime in seconds (default: 12 hours).
SESSION_TTL=43200
