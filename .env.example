# Optional: Ohne diese Werte ist das Dashboard im lokalen Netz ohne Login erreichbar.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=bitte-aendern

# Auf false setzen, wenn Container nur angezeigt, aber nicht gesteuert werden sollen.
ALLOW_DOCKER_ACTIONS=true

# Optional, falls keine Samba-Freigaben oder Ordner unter /mnt, /srv, /media erkannt werden.
# Mehrere Pfade mit Komma trennen, zum Beispiel: /data/media,/data/backups
SHARE_ROOTS=

# SSH-Ziel für die vollständige Host-CLI.
SSH_HOST=auto
SSH_PORT=22

# Bei HTTPS auf true setzen. Session-Laufzeit standardmäßig 12 Stunden.
COOKIE_SECURE=false
SESSION_TTL=43200
